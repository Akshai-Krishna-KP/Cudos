#!/bin/sh
# trackc-dashboard: live GPU metrics + latest benchmark results on the console.
R=/var/lib/trackc-bench/bench-results.jsonl
while :; do
  printf '\033[H\033[2J'
  echo "Track C GPU appliance   $(date '+%F %T')   up $(cut -d. -f1 /proc/uptime)s"
  echo
  nvidia-smi --query-gpu=name,temperature.gpu,power.draw,utilization.gpu,memory.used,clocks.sm,pstate \
    --format=csv 2>/dev/null || echo "GPU not ready"
  echo
  echo "Benchmark runs: $(wc -l < "$R" 2>/dev/null || echo 0)   (container: rootless podman, user bench)"
  tail -n 5 "$R" 2>/dev/null | sed -e 's/[{}"]//g' -e 's/,/  /g' | cut -c1-200
  sleep 2
done
