#!/bin/sh
# trackc-bench-run: runs the CUDA benchmark container ONCE (rootless Podman, GPU via CDI)
# as the calling unprivileged user.
#   (no args)    boot health check: one run, appended to ~/bench-results.jsonl and
#                copied to ~/latest.json for the console banner (gpu-status)
#   once [args]  one run, result on stdout only (gpu-bench, measure/collect.sh)
set -eu
IMG=localhost/trackc-bench:0.1
: "${XDG_RUNTIME_DIR:=/run/trackc-bench}"; export XDG_RUNTIME_DIR
[ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ] || XDG_RUNTIME_DIR=$(mktemp -d)
podman image exists "$IMG" 2>/dev/null || podman load -q -i /usr/share/trackc/trackc-bench.tar >/dev/null
run() {
  # No --read-only: the NVIDIA CDI hook must write ld.so.cache inside the container.
  podman run --rm --cgroups=disabled --network=none --cap-drop=all \
    --security-opt=no-new-privileges \
    --device nvidia.com/gpu=all "$IMG" "$@"
}
if [ "${1:-}" = once ]; then shift; run "$@"; exit; fi
touch "$XDG_RUNTIME_DIR/started"          # time-to-benchmark marker (measure/collect.sh)
r=$(run --label boot)
echo "$r" | tee -a "$HOME/bench-results.jsonl"
echo "$r" > "$HOME/latest.json"
