[Unit]
Description=Track C GPU health check: CUDA benchmark once at boot (rootless container, non-root)
Requires=gpu-autoconfig.service
After=gpu-autoconfig.service nvidia-powerd.service

[Service]
# exec, not oneshot: the health check must not hold up boot (multi-user.target).
Type=exec
RemainAfterExit=yes
User=bench
Group=bench
RuntimeDirectory=trackc-bench
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
Environment=XDG_RUNTIME_DIR=/run/trackc-bench
ExecStart=/usr/local/sbin/trackc-bench-run
TimeoutStartSec=300
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
