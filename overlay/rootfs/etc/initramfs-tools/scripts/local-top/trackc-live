#!/bin/sh
# trackc-live: boot from the live ISO (kernel cmdline has trackc.live). The root squashfs
# is a FILE on the iso9660 volume labelled TRACKC_LIVE (CD/DVD, VM, or the ISO written to a
# USB stick): mount it and attach live/rootfs.squashfs to /dev/loop0 (root=/dev/loop0).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
grep -qw trackc.live /proc/cmdline || exit 0
. /scripts/functions
for m in isofs loop sr_mod cdrom usb_storage uas; do modprobe -q $m 2>/dev/null; done
mkdir -p /run/trackc/iso
# Find the live medium: try CD drives and USB/virtual disks (never internal NVMe) as iso9660
# and look for our marker. (udev in the initramfs does not label sr* or hybrid-ISO disks.)
found=
i=0
while [ $i -lt 150 ] && [ -z "$found" ]; do
  for d in /dev/sr[0-9]* /dev/sd[a-z] /dev/vd[a-z]; do
    [ -b "$d" ] || continue
    if mount -t iso9660 -o ro "$d" /run/trackc/iso 2>/dev/null; then
      if [ -f /run/trackc/iso/live/trackc-live.id ]; then found=$d; break; fi
      umount /run/trackc/iso
    fi
  done
  [ -n "$found" ] || { sleep 0.2; i=$((i + 1)); }
done
[ -n "$found" ] || panic "trackc-live: live medium (live/trackc-live.id) not found"
log_success_msg "trackc-live: live medium on $found"
losetup -r /dev/loop0 /run/trackc/iso/live/rootfs.squashfs || panic "trackc-live: cannot attach rootfs.squashfs"
log_success_msg "trackc-live: root is live/rootfs.squashfs on the ISO"
exit 0
