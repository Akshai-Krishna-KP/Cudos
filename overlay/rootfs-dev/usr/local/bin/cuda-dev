#!/bin/sh
# cuda-dev: compile and run your own CUDA code on the appliance.
# The host has no CUDA toolkit; this runs the CUDA 13.5 development container
# (nvcc, gcc, cuBLAS, cuRAND, cuFFT, NVRTC) rootless, as you, with the GPU via CDI,
# no network and no capabilities. Your workspace ~/cuda (= /var/lib/cuda-work/$USER,
# on the persistent partition) is mounted at /work and keeps its files across reboots.
#
#   cuda-dev                         interactive shell with nvcc in ~/cuda
#   cuda-dev nvcc -arch=sm_89 -o hello hello.cu
#   cuda-dev ./hello
#   cuda-dev list|install|remove|reset   = lazarus ...  (CUDA package manager, see lazarus --help)
#   cuda-dev --help
set -eu
BASE=localhost/trackc-cuda-dev:13.5
USERIMG=localhost/trackc-cuda-dev-user:latest     # base + your added libraries (persist partition)
TAR=/run/trackc/persist/images/trackc-cuda-dev.tar
[ -r "$TAR" ] || TAR=/run/trackc/iso/images/trackc-cuda-dev.tar   # live ISO
SHARE=${TRACKC_CUDA_SHARE:-/usr/share/trackc/cuda-dev}
U=$(id -un); W=/var/lib/cuda-work/$U
P() { podman --log-level=error "$@"; }
die() { echo "cuda-dev: $*" >&2; exit 1; }
if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0; fi
[ "$(id -u)" != 0 ] || die "run it as a normal user (rootless), not as root"

ensure_base() {
  P image exists "$BASE" 2>/dev/null && return 0
  [ -r "$TAR" ] || die "CUDA toolkit image not installed ($TAR). From the build host: build/container/install-cudadev.sh <ip>"
  echo "cuda-dev: first use, loading the CUDA toolkit image (1-2 minutes)..." >&2
  P load -q -i "$TAR" >/dev/null
}
current_img() { if P image exists "$USERIMG" 2>/dev/null; then echo "$USERIMG"; else echo "$BASE"; fi; }
case "${1:-}" in
  list|install|remove|reset|update|mirror) exec lazarus "$@" ;;   # package management: lazarus
esac

[ -d "$W" ] && [ -w "$W" ] || die "workspace $W missing"
[ -d "$W/examples" ] || cp -r /usr/share/trackc/examples "$W/examples"
ensure_base
# Same sub-directory inside the container when called from within ~/cuda.
rel=
here=$(pwd -P)
case "$here/" in
  "$W"/*) rel=${here#"$W"} ;;
  *) [ $# -eq 0 ] || echo "cuda-dev: note: only ~/cuda is visible inside; running in ~/cuda" >&2 ;;
esac
[ $# -gt 0 ] || set -- bash
tty=; [ -t 0 ] && [ -t 1 ] && tty=-it
# No --userns=keep-id: in rootless Podman, root inside the container IS your own user outside
# (files in ~/cuda stay yours), and keep-id would force a slow re-owned copy of the whole
# toolkit image (minutes on a USB stick) after every lazarus-install. Still: no capabilities,
# no-new-privileges, no network.
exec podman --log-level=error run --rm $tty --cgroups=disabled --network=none --cap-drop=all \
  --security-opt=no-new-privileges --device nvidia.com/gpu=all \
  -v "$W:/work" -w "/work$rel" -e HOME=/work "$(current_img)" "$@"
