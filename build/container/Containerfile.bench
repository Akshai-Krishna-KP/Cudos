# Containerfile.bench: slim CUDA benchmark image (multi-stage).
# Stage 1 compiles benchmark/src/trackc_bench.cu with nvcc (sm_89 only).
# Stage 2 carries only the binary + the cuBLAS runtime libraries it links
# (cudart is linked statically by nvcc). No nvcc, headers or static libs ship.
# Built offline from the prefetched .debs (baseline/prefetch-debs.sh), mounted at /debs.
ARG BASE
FROM ${BASE} AS build
# dpkg --force-depends: throw-away build stage, only gcc/g++/nvcc must run (skips build-essential/perl/dpkg-dev).
RUN --network=none cd /debs && dpkg -i --force-depends \
      ./libc6_*.deb ./libc-bin_*.deb ./g++_*.deb ./g++-13_*.deb ./g++-13-x86-64-linux-gnu_*.deb ./g++-x86-64-linux-gnu_*.deb \
      ./gcc_*.deb ./gcc-13_*.deb ./gcc-13-base_*.deb ./gcc-13-x86-64-linux-gnu_*.deb ./gcc-x86-64-linux-gnu_*.deb \
      ./cpp_*.deb ./cpp-13_*.deb ./cpp-13-x86-64-linux-gnu_*.deb ./cpp-x86-64-linux-gnu_*.deb \
      ./libstdc++-13-dev_*.deb ./libgcc-13-dev_*.deb ./libc6-dev_*.deb ./libc-dev-bin_*.deb ./linux-libc-dev_*.deb \
      ./libcrypt-dev_*.deb ./rpcsvc-proto_*.deb ./binutils_*.deb ./binutils-common_*.deb ./binutils-x86-64-linux-gnu_*.deb \
      ./libbinutils_*.deb ./libctf0_*.deb ./libctf-nobfd0_*.deb ./libgprofng0_*.deb ./libsframe1_*.deb ./libjansson4_*.deb \
      ./libasan8_*.deb ./libatomic1_*.deb ./libcc1-0_*.deb ./libgomp1_*.deb ./libhwasan0_*.deb ./libisl23_*.deb ./libitm1_*.deb \
      ./liblsan0_*.deb ./libmpc3_*.deb ./libmpfr6_*.deb ./libquadmath0_*.deb ./libtsan2_*.deb ./libubsan1_*.deb \
      ./cuda-nvcc-13-5_*.deb ./cuda-crt-13-5_*.deb ./cuda-cudart-13-5_*.deb ./cuda-cudart-dev-13-5_*.deb \
      ./cuda-culibos-dev-13-5_*.deb ./cuda-driver-dev-13-5_*.deb ./cuda-toolkit-13-5-config-common_*.deb \
      ./cuda-toolkit-config-common_*.deb ./libcublas-13-5_*.deb ./libcublas-dev-13-5_*.deb ./libnvvm-13-5_*.deb \
      ./cccl-13-5_*.deb ./cuda-toolkit-13-config-common_*.deb ./libnvptxcompiler-13-5_*.deb

COPY trackc_bench.cu /src/
RUN /usr/local/cuda-13.5/bin/nvcc -O2 -arch=sm_89 -o /trackc_bench /src/trackc_bench.cu -lcublas \
 && mkdir -p /out/lib && cp -L /usr/local/cuda-13.5/targets/x86_64-linux/lib/libcublas.so.13 \
      /usr/local/cuda-13.5/targets/x86_64-linux/lib/libcublasLt.so.13 /out/lib/

FROM ${BASE}
COPY --from=build /trackc_bench /usr/local/bin/trackc_bench
COPY --from=build /out/lib/ /usr/local/lib/trackc/
ENV LD_LIBRARY_PATH=/usr/local/lib/trackc
# Non-root inside the container too.
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/trackc_bench"]
