# Single source of truth for all version pins. Sourced by build/measure scripts.
# Every pin here was checked against the upstream source on the date noted.

# --- Stock baseline (Phase 0/1) ---
# Checked 2026-11-19 against https://releases.ubuntu.com/24.04/SHA256SUMS
UBUNTU_BASELINE_ISO="ubuntu-24.04.5-live-server-amd64.iso"
UBUNTU_BASELINE_URL="https://releases.ubuntu.com/24.04/${UBUNTU_BASELINE_ISO}"
UBUNTU_BASELINE_SHA256="97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8"

# --- NVIDIA stack for the stock baseline (Ubuntu 24.04) ---
# Checked 2026-11-19 against
# https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/Packages.gz
# Driver matches the CachyOS host driver (620.70.06) so both sides use the same branch.
NVIDIA_REPO_URL="https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64"
CUDA_KEYRING_DEB="cuda-keyring_1.1-1_all.deb"
NVIDIA_DRIVER_VERSION="620.70.06"
CUDA_TOOLKIT_PKG="cuda-toolkit-13-5"        # 13.5.0-1
CUDNN_PKG="cudnn9-cuda-13"                  # 9.28.1.4-1
NVIDIA_CTK_VERSION="1.20.2-1"

# --- Custom image base (Phase 2) ---
# Checked 2026-11-19: Debian stable = 13.7 "trixie" (deb.debian.org Release file).
# snapshot.debian.org resolved 20261115T000000Z -> 20261114T202348Z; pin the exact one.
DEBIAN_SUITE="trixie"
DEBIAN_SNAPSHOT="20261114T202348Z"
DEBIAN_MIRROR="https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}"
DEBIAN_SECURITY_MIRROR="https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}"
# Build container base: debian:trixie-slim, pinned by digest (pulled 2026-11-19).
BUILDER_BASE_IMAGE="docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392"
# Reproducible timestamps: the snapshot time (2026-11-14T20:23:48Z).
SOURCE_DATE_EPOCH="1794687828"
