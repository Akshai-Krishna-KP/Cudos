# Containerfile.kernel: kernel build environment (pinned Debian snapshot, like the builder).
ARG BUILDER_BASE_IMAGE
FROM ${BUILDER_BASE_IMAGE}
ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SUITE
RUN rm -f /etc/apt/sources.list.d/debian.sources && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s %s main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s %s-updates main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s %s-security main\n' \
      "$DEBIAN_SNAPSHOT" "$DEBIAN_SUITE" "$DEBIAN_SNAPSHOT" "$DEBIAN_SUITE" "$DEBIAN_SNAPSHOT" "$DEBIAN_SUITE" > /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=5 update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential bc bison flex libssl-dev libelf-dev cpio kmod rsync dpkg-dev debhelper \
      python3 xz-utils zstd ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
