# trackc.config: our kernel config fragment, applied on top of
#   Debian 13's 6.12 config  +  `make localmodconfig` (modules loaded on both laptops)
# Every line says why.
CONFIG_LOCALVERSION="-trackc"
# CONFIG_LOCALVERSION_AUTO is not set
# Module signing off: decided not to use Secure Boot signing (documented limitation).
# CONFIG_MODULE_SIG is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# No debug info / BTF: much smaller modules and a faster build; not needed on an appliance.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Needed by the appliance even if not loaded when the module lists were taken:
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=m
CONFIG_EXT4_FS=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_BLK_DEV_NVME=m
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_TUN=m
# QEMU smoke test (test/qemu-smoke.sh) boots from a virtio disk; tiny.
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
