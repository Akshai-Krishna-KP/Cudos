# trackc-iso.config: extra options for the LIVE ISO kernel only (out/kernel-iso), on top of
# trackc.config. The ISO must boot on unknown PCs and VMs, not just our two NVMe laptops.
# Read the ISO and mount the squashfs file inside it:
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_BLK_DEV_LOOP=m
# CD/DVD drives:
CONFIG_BLK_DEV_SR=m
CONFIG_CDROM=m
# SATA/IDE controllers (CD drives, VirtualBox/QEMU/VMware disks); trimmed from the laptop kernel:
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_ATA_PIIX=m
CONFIG_SCSI_VIRTIO=m
# Older USB 2.0 / 1.1 host controllers (the laptop kernel keeps only USB 3 xhci):
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_EHCI_PCI=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_OHCI_HCD_PCI=m
CONFIG_USB_UHCI_HCD=m
